# V4-9c: the application-message decoders. Tokens are OPS and LENGTH bytes --
# the two things the decoder branches on. There are no labels here: the digest
# labels never appear in a message, they are hashed into a signature.
op_login_code="\x10"
op_rotate="\x11"
op_rotate_ack="\x12"
op_error="\x1f"
op_bye="\x20"
version_1="\x01"
version_0="\x00"
version_2="\x02"
flags_none="\x00"
flags_drop_tokens="\x01"
flags_reserved="\x02"
handle_len_0="\x00"
handle_len_1="\x01"
handle_len_34="\x22"
handle_len_64="\x40"
handle_len_65="\x41"
siglen_0="\x00\x00"
siglen_1="\x00\x01"
siglen_max="\x0c\xed"
siglen_over="\x0c\xee"
siglen_ffff="\xff\xff"

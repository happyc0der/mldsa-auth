# fuzz_envelope: MLDSAEK1 header field tokens for keyfile_parse_header.
# Big-endian values only; no protocol label is attacker-supplied (labels
# live in the AEAD's associated data, which the harness builds, not the input).
magic="MLDSAEK1"
version_01="\x01"
kdf_argon2id13="\x01"
aead_xchacha20poly1305="\x01"
opslimit_min="\x00\x00\x00\x01"
opslimit_max="\x00\x00\x00\x0a"
opslimit_over="\x00\x00\x00\x0b"
memlimit_min_8mib="\x00\x00\x00\x00\x00\x80\x00\x00"
memlimit_max_1gib="\x00\x00\x00\x00\x40\x00\x00\x00"
memlimit_under_min="\x00\x00\x00\x00\x00\x7f\xff\xff"
ctlen_header_67="\x00\x00\x00\x43"

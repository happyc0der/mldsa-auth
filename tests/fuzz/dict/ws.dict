# fuzz_ws: the two things the WebSocket layer branches on -- HTTP header names
# in the upgrade, and the opcode/length bytes in a frame. The accept value is
# NOT a token: it is a SHA-1 of the client's own key, so no fixed string helps.
http_get="GET "
http_ver=" HTTP/1.1\x0d\x0a"
h_upgrade="Upgrade: websocket\x0d\x0a"
h_connection="Connection: Upgrade\x0d\x0a"
h_version="Sec-WebSocket-Version: 13\x0d\x0a"
h_key="Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\x0d\x0a"
h_state="?state="
crlfcrlf="\x0d\x0a\x0d\x0a"
op_binary_fin="\x82"
op_cont_fin="\x80"
op_text_fin="\x81"
op_close="\x88"
op_ping="\x89"
op_pong="\x8a"
op_rsv_set="\xc2"
len_masked_0="\x80"
len_masked_125="\xfd"
len_masked_126="\xfe"
len_masked_127="\xff"
len_unmasked_4="\x04"
mask="\x11\x22\x33\x44"
framelen_8="\x00\x00\x00\x08"
framelen_0="\x00\x00\x00\x00"
framelen_max="\x00\x00\x30\x19"
# PROXY protocol v2 (V4-10b). The signature is the one token nothing else can
# produce by chance -- twelve fixed bytes the fuzzer would otherwise never
# assemble -- and the ver/cmd, family and length bytes are what the parser
# branches on immediately after it.
pp2_signature="\x0d\x0a\x0d\x0a\x00\x0d\x0a\x51\x55\x49\x54\x0a"
pp2_v2_proxy="\x21"
pp2_v2_local="\x20"
pp2_v1_proxy="\x11"
pp2_fam_inet="\x11"
pp2_fam_inet6="\x21"
pp2_fam_unix="\x31"
pp2_fam_unspec="\x00"
pp2_len_12="\x00\x0c"
pp2_len_36="\x00\x24"
pp2_len_0="\x00\x00"
pp2_len_max="\xff\xff"

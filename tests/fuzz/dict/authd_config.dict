# fuzz_authd_config: the key names and the structural bytes of a `key = value`
# config. Tokens are what a mutator needs to build a line the parser will take
# seriously; values are covered by the seeds and the bounds.
k_store="store_path"
k_key="key_path"
k_passfile="key_passphrase_file"
k_server_id="server_id"
k_listen_unix="listen_unix"
k_listen_port="listen_port"
k_max_slots="max_slots"
k_hs_timeout="handshake_timeout_ms"
k_idle_timeout="idle_timeout_ms"
k_pad_bucket="pad_bucket"
eq=" = "
nl="\x0a"
comment="#"
bucket_256="256"
bucket_32="32"
slots_max="4096"
k_log_ids="log_identities"
k_log_ip="log_client_ip"
v_full="full"
v_hashed="hashed"
v_prefix="prefix"
v_off="off"
# V4-296, F505: every key the parser knows (the ones added after V4-8a were
# missing, so the deterministic replay never parsed them).
k_site_socket="site_socket"
k_admin_socket="admin_socket"
k_site_uids="site_uids"
k_admin_uids="admin_uids"
k_max_local_slots="max_local_slots"
k_rotation_age="rotation_due_age_s"
k_proxy_protocol="proxy_protocol"
k_proxy_uids="proxy_uids"
k_rate_per_min="rate_per_min"
k_rate_burst="rate_burst"
k_rate_global="rate_global_per_sec"
k_max_conns="max_conns_per_addr"
v_v2="v2"
comma=","

# mldsa-authd — the post-quantum authentication daemon (spec §16).
#
# THIS FILE IS UNDER TEST. tests/deploy_checks.sh runs `systemd-analyze verify`
# on it and requires NO output — the exit status is not a gate, because
# systemd-analyze exits 0 even for an unknown directive and merely warns — and
# runs `systemd-analyze security --offline=true`, requiring an exposure score
# below a threshold. A unit that drifted from what passes would fail the build
# rather than mislead an operator on the day they need it.
#
# Install:
#   install -m 0644 mldsa-authd.service /etc/systemd/system/
#   systemctl daemon-reload
# See deploy/RUNBOOK.md for the whole sequence; this file is step 6 of it.

[Unit]
Description=mldsa-authd post-quantum authentication daemon
Documentation=https://github.com/happyc0der/mldsa-auth
# The daemon binds a Unix socket the proxy connects to; it does not require the
# proxy, and it must be able to start before it so the socket exists when the
# proxy first tries.
After=network.target
Wants=network.target

[Service]
# Type=notify (V4-104): the daemon says READY=1 once its key is unsealed and
# every listener is bound, so `systemctl start`/`restart` return only then.
# As Type=simple they returned at fork, and a login sent straight after a
# restart found nothing listening -- unsealing the key is a 256 MiB Argon2id.
Type=notify
User=mldsa-authd
Group=mldsa-authd
# --check-config at every start, here because only here does it see what it
# checks: the credential under /run/credentials/ and RuntimeDirectory= exist
# only while systemd starts the service, so run by hand beforehand it can
# only fail (V4-99). Its line of resolved settings is the first thing in the
# journal; a configuration it refuses stops the start there, with the reason.
ExecStartPre=/usr/local/bin/mldsa-authd --config /etc/mldsa-authd/authd.conf --check-config
ExecStart=/usr/local/bin/mldsa-authd --config /etc/mldsa-authd/authd.conf
# No ExecReload=: the daemon reads its configuration once, at start. A SIGHUP
# is logged (`sighup-ignored`) and ignored; before V4-121 it killed the
# daemon, and Restart=on-failure does not restart after SIGHUP, which systemd
# counts as a clean exit. Use `systemctl restart` to apply a change.
Restart=on-failure
RestartSec=2s

# The passphrase that opens the MLDSAEK1 server key (spec §12). systemd
# decrypts it into $CREDENTIALS_DIRECTORY. MEASURED (V4-99, Ubuntu 26.04): the
# file is root:root, mode 0440, read by this service's user through an ACL, on
# a private read-only tmpfs. This comment used to say "a 0400 file owned by
# this service", and the daemon refused the real thing; authd_secret.c now
# accepts exactly that shape, and only inside $CREDENTIALS_DIRECTORY (spec §12,
# erratum 74). Never an environment variable, never argv: both are readable by
# other processes.
#
#   systemd-creds encrypt --name=passphrase /var/lib/mldsa-authd/pass -
# and paste the output as SetCredentialEncrypted=, or keep the file and use
# LoadCredentialEncrypted= as below.
LoadCredentialEncrypted=passphrase:/etc/mldsa-authd/passphrase.cred

# /run/mldsa-authd/ 0750, owned by this user, group-readable by the proxy
# (spec §16). systemd creates and removes it, so a crashed daemon never leaves
# a stale directory with the wrong mode.
RuntimeDirectory=mldsa-authd
RuntimeDirectoryMode=0750
# /var/lib/mldsa-authd/ 0700 holds the store, the sealed key and backups.
StateDirectory=mldsa-authd
StateDirectoryMode=0700

# LOCKED MEMORY IS A CORRECTNESS SETTING, NOT A TUNING KNOB (spec §16).
#
# libsodium calls mlock() for every secure allocation, IGNORES its failure, and
# returns memory that looks identical to locked memory. V4-2's S1 spike
# measured the consequence: under a 64 KiB limit, 1000 of 1000 allocations
# still succeeded and only ~16 were actually locked. No error, no log line —
# the daemon's keys simply become swappable.
#
# The requirement is 4 KiB x 10 x max_slots: about ten secure allocations per
# in-flight handshake, one locked page each. The value below covers the default
# max_slots = 256 (10 MiB) with headroom for the store and the server key.
# RAISE IT IF YOU RAISE max_slots — the daemon logs `memlock-limit` at WARN
# when its own limit is short, so the journal will tell you.
LimitMEMLOCK=32M

# Open files: the daemon needs max_slots + max_local_slots + 32, and raises
# its own soft limit to that at start (it logs `fd-limit`). systemd's default
# hard limit is far above the most the configuration can ask for (4136), so
# nothing is set here. If `fd-limit` is ever at WARN, something lowered the
# hard limit: set LimitNOFILE= to at least the `need=` it prints. Until then
# the daemon holds fewer connections than max_slots.

# --- hardening (spec §16's list, verbatim) --------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitCORE=0

# A core dump of this process could contain the server's secret key in
# plaintext. LimitCORE=0 above stops the kernel writing a core FILE. A piped
# core_pattern (systemd-coredump, apport) is not bound by it: those two honour
# a zero limit, others need not. What covers the keys under any handler is
# that they live in libsodium's sodium_malloc regions, which it marks
# MADV_DONTDUMP on Linux. No directive below adds to this (F154, V4-74).
ProtectHostname=yes
ProtectClock=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target

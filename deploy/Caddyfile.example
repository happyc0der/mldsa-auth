# The proxy in front of mldsa-authd (spec docs/mldsa-authd-spec.md §7.1, §7.2).
#
# THIS FILE IS THE ONE UNDER TEST. tests/caddy_proxy.sh copies it into a
# container, runs `caddy validate` on it, starts a real Caddy with it, and
# performs a real post-quantum login through it -- so an example that drifted
# from what works would fail the leg rather than mislead an operator.
#
# Two things matter and both are load-bearing:
#
#   proxy_protocol v2
#       The preamble Caddy prepends before the client is allowed to write a
#       byte. It is the ONLY unforgeable statement of the client's address the
#       daemon can get, because everything else it can see is Caddy. Without
#       it the daemon has no address, refuses the connection (Req 12), and
#       says `event=closed-protocol` in the journal.
#
#   a Unix-socket upstream
#       The daemon's proxy-facing listener is a Unix socket, mode 0660, whose
#       peer uid must appear in the daemon's `proxy_uids` (Req 11). The
#       preamble is only trustworthy because the peer that wrote it is the
#       proxy; run Caddy as a user that is in that list and nothing else.
#
# WebSocket needs no directive: reverse_proxy passes an Upgrade through.
#
# Replace the site address and let Caddy manage the certificate; the TLS half
# is Caddy's job and the daemon never sees it.
#
# The browser client (V4-13c) adds the rest of the SITE behind the same origin:
# the pages, the wasm module and the site's own endpoints, here a site app on
# 127.0.0.1:9080 (examples/site-node/server.mjs --port 9080, or yours). Same origin matters
# twice: the page's WebSocket to /authd/v1 is covered by `connect-src 'self'`,
# and the login code is POSTed back to the site without ever leaving it.
#
# The headers are the reference site's (examples/site-node/server.mjs, CSP):
# `'wasm-unsafe-eval'` is REQUIRED to compile the WebAssembly module and allows
# nothing else -- no inline script, no eval. Caddy serves `.wasm` as
# application/wasm by itself, which streaming compilation needs.

# Global options. What Caddy itself logs (V4-291, F488's neighbour F489): no
# access log is configured, but its error logger writes the request of every
# failed proxying -- a 502 while the daemon restarts (step 22, step 23, a
# watchdog kill) or while the site does -- with the client's full address,
# the login URL's `state` and every header but the cookie. The daemon's own
# lines keep a /24 or /48 under `log_client_ip = prefix` (step 15); this
# keeps the proxy's lines to the same, and drops the `state` and the
# browser's identifying headers. Merge it with your own global block if you
# have one: there can be only one, first in the file.
{
	log default {
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>uri query {
					delete state
				}
				request>headers>User-Agent delete
				request>headers>Origin delete
				request>headers>Referer delete
				request>headers>Sec-Websocket-Key delete
			}
		}
	}
}

# One upstream, used twice below.
(authd_upstream) {
	reverse_proxy unix//run/mldsa-authd/p.sock {
		# The daemon reads at most 4,096 bytes of upgrade request and
		# closes on more. A browser sends every cookie it holds for this
		# domain with the upgrade; the daemon uses none of them, so they
		# stop here (V4-192, F271).
		header_up -Cookie
		transport http {
			proxy_protocol v2
		}
	}
}

authd.example.com {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	# Only a WebSocket upgrade reaches the daemon, and from a browser only
	# this site's own pages (V4-269, F417). The daemon charges the client
	# address's rate-limit bucket for every connection, before it has read
	# the request. With `/authd/v1*` forwarded as it came, any page on any
	# site could spend the visitor's own bucket for them -- ten image tags
	# pointing here, then one every twelve seconds -- and their real login
	# was answered 429. A browser always sends Origin with an upgrade; a
	# native client (authd_client) sends none. REPLACE THE ORIGIN below
	# together with the site address above.
	# Exactly this path, by GET (F605): `/authd/v1*` also forwarded
	# `/authd/v1evil` and any method, which the reference site's own relay
	# stopped doing in V4-326. Anything else under that prefix goes to the
	# site below, which answers it as it does any unknown path.
	# The request's target AS IT WAS SENT is what is compared (F615), and
	# neither `path` nor `path_regexp` does that: both match the path after
	# Caddy has decoded and cleaned it, and `path` ignores case as well, so
	# `/AUTHD/V1`, `//authd/v1` and `/%61uthd/v1` would be the daemon's too.
	@authd {
		method GET
		expression `{http.request.orig_uri}.matches("^/authd/v1([?].*)?$")`
	}
	handle @authd {
		@page {
			header Upgrade websocket
			header Origin https://authd.example.com
		}
		@native {
			header Upgrade websocket
			not header Origin *
		}
		handle @page {
			import authd_upstream
		}
		handle @native {
			import authd_upstream
		}
		handle {
			respond 403
		}
	}
	handle {
		reverse_proxy 127.0.0.1:9080
	}
}
